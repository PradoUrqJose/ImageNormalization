# Copiar a .env.local y completar. NUNCA commitear .env.local (ya está en .gitignore).
# Credenciales de Cloudflare R2 (API compatible con S3). Crear un token limitado
# SOLO al bucket del catálogo, con permisos de lectura y escritura de objetos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Normalmente https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# URL pública del bucket (r2.dev o dominio propio), sin barra final.
R2_PUBLIC_URL=

# Opcional — SOLO para el botón "RMBG 2.0" (modelo con acceso restringido).
# Aceptar la licencia en https://huggingface.co/briaai/RMBG-2.0 y crear un
# token de LECTURA en https://huggingface.co/settings/tokens. Ver docs/MODELOS_PYTORCH.md.
HF_TOKEN=

# Catálogo ERP opcional: bucket PRIVADO, token sólo lectura separado del token de fotos.
ERP_CATALOG_BUCKET=
ERP_CATALOG_ENDPOINT=
ERP_CATALOG_ACCESS_KEY_ID=
ERP_CATALOG_SECRET_ACCESS_KEY=
# Acceso al editor cuando usa catálogo ERP; se pide usuario/contraseña en el navegador.
ERP_CATALOG_APP_USER=
ERP_CATALOG_APP_PASSWORD=
# Sólo demo local de desarrollo; no activar en Vercel.
# ERP_CATALOG_FILE=/ruta/catalogo/erp.json
